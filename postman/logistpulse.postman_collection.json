    {
      "name": "Listar pedidos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/orders?page=0&size=5",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "orders"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('pagina con enlaces', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.content).to.be.an('array').with.length.of.at.most(5);",
              "  pm.expect(b.links).to.have.property('self');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/orders",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"customer\": \"Postman\", \"destX\": 10, \"destY\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const orderSchema = {",
              "  type: 'object',",
              "  required: ['id', 'code', 'customer', 'destX', 'destY', 'status', 'warehouse', 'createdAt', 'links'],",
              "  properties: {",
              "    id: { type: 'integer' },",
              "    code: { type: 'string' },",
              "    customer: { type: 'string' },",
              "    destX: { type: 'integer' },",
              "    destY: { type: 'integer' },",
              "    status: { enum: ['CREATED', 'DISPATCHED', 'IN_TRANSIT', 'DELIVERED', 'CANCELLED', 'RETURNED'] },",
              "    warehouse: { type: 'string' },",
              "    robot: { type: ['string', 'null'] },",
              "    etaMinutes: { type: ['integer', 'null'] },",
              "    createdAt: { type: 'string' },",
              "    links: { type: 'object' }",
              "  }",
              "};",
              "// 1) código de estado",
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "// 2) cabecera Location apunta al recurso creado",
              "pm.test('Location termina en /api/orders/{id}', () => {",
              "  const loc = pm.response.headers.get('Location');",
              "  pm.expect(loc).to.match(/\\/api\\/orders\\/\\d+$/);",
              "  pm.expect(loc.split('/').pop()).to.equal(String(pm.response.json().id));",
              "});",
              "// 3) esquema de la respuesta",
              "pm.test('esquema del pedido', () => pm.response.to.have.jsonSchema(orderSchema));",
              "pm.test('nace CREATED y sin robot', () => {",
              "  pm.expect(pm.response.json().status).to.eql('CREATED');",
              "  pm.expect(pm.response.json().robot).to.eql(null);",
              "});",
              "pm.collectionVariables.set('orderId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Obtener pedido por id",
